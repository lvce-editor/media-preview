{
  "name": "builtin.media-preview-monorepo",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node packages/build/src/build.js",
    "dev": "node ./packages/build/src/dev.js",
    "e2e": "npm run build && cd packages/e2e && npm run e2e",
    "e2e:headless": "npm run build && cd packages/e2e && npm run e2e:headless",
    "lint": "eslint . && prettier --check . && knip --no-config-hints",
    "test": "npm test --workspaces --if-present",
    "test:watch": "node --unhandled-rejections=warn --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "type-check": "tsc -b"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 130
  },
  "devDependencies": {
    "@lvce-editor/eslint-config": "^18.4.0",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "jest": "^30.4.2",
    "knip": "^6.32.1",
    "prettier": "^3.9.6",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.0"
  }
}
