{
  "name": "image-conversion-worker",
  "version": "0.0.0-dev",
  "license": "MIT",
  "type": "module",
  "main": "src/imageConversionWorkerMain.ts",
  "scripts": {
    "test": "node --unhandled-rejections=warn --experimental-vm-modules ../../node_modules/jest/bin/jest.js --detectOpenHandles --forceExit"
  },
  "jest": {
    "injectGlobals": false,
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "useESM": true
        }
      ]
    }
  },
  "dependencies": {
    "@lvce-editor/rpc": "^6.16.0",
    "fast-png": "^8.0.0",
    "heic-decode": "^2.1.0",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@types/heic-decode": "^2.0.0"
  }
}
